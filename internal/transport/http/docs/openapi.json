{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "CRUD API for tasks built with clean architecture. Supports task chains with recurrence schedules (every N-th day, every even/odd day, every N-th month day, sparse dates)."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Task Chains",
      "description": "Operations for generating and managing chains of tasks from a master task"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "description": "Creates a new task. If `deadline` is sent, `start_at` is also required. `deadline` must be after `start_at`.\n\nIf `chain_generation` is provided, the created task becomes a **master task** with the given schedule, and a chain of recurring tasks is generated according to the schedule. The response contains the master task (the generated chain is stored but not returned directly).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created (master task)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "description": "Updates an existing task. If `deadline` is sent, `start_at` is also required. `deadline` must be after `start_at`.\n\n**Important:** Changing `start_at` or `deadline` will break the link to the master task (the task becomes standalone).\n\nSetting `make_standalone` to `true` explicitly removes the link to the master task.\n\nIf the task is a master task (has a schedule), updating its `title` or `description` will automatically propagate these changes to all dependent tasks with `status = new` in its chain.\n\nThis endpoint cannot change the task's schedule.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}/chain": {
      "get": {
        "tags": ["Task Chains"],
        "summary": "Get task chain by master ID",
        "description": "Returns all tasks that belong to the same chain as the given task (including the master task itself).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task chain",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Task Chains"],
        "summary": "Generate chain from a task",
        "description": "Turns an existing task into a master task and generates a chain of recurring tasks based on the provided schedule. The original task is updated to become the master (its `master_task_id` is set to NULL and the schedule is attached).\n\nIf the task is already part of a chain (i.e., it has dependent tasks), the request fails unless the chain consists only of the task itself.\n\nThis endpoint works uniformly for all schedule types (including `sparse_dates`).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChainGeneration" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Generated task chain (including the master task)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Task Chains"],
        "summary": "Propagate task chain",
        "description": "Extends an existing task chain by generating new tasks after the latest existing task (or from an optional custom start date) using the master task's schedule. The schedule must already be defined on the master task.\n\nIf `start` is not provided, the generation starts from the latest `start_at` among existing chain tasks (excluding the master).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChainPropagation" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Extended task chain (all tasks, including existing and newly generated)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:01:00Z"
          },
          "chain_generation": {
            "$ref": "#/components/schemas/ChainGeneration"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:01:00Z"
          },
          "make_standalone": {
            "type": "boolean",
            "description": "If true, the task is detached from its master task chain",
            "example": false
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Prepare release" },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "master_task_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the master task if this task belongs to a chain. If `null`, the task is a master task.",
            "example": 5
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule",
            "description": "Recurrence schedule. Only present on master tasks."
          }
        }
      },
      "ChainGeneration": {
        "type": "object",
        "required": ["schedule"],
        "properties": {
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the generation window (inclusive). Defaults to current time.",
            "example": "2026-04-01T00:00:00Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "End of the generation window (exclusive). Defaults to start + 3 months.",
            "example": "2026-07-01T00:00:00Z"
          }
        }
      },
      "ChainPropagation": {
        "type": "object",
        "description": "Parameters for extending an existing task chain.",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Optional custom start date for generation. If not provided, generation starts from the latest `start_at` among existing chain tasks.",
            "example": "2026-08-01T00:00:00Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "End of the generation window (exclusive). Defaults to `start` + 3 months if not provided.",
            "example": "2026-11-01T00:00:00Z"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "description": "Recurrence schedule for generating a task chain. Exactly one of the fields must be provided.",
        "properties": {
          "sparse_dates": {
            "type": "array",
            "items": { "type": "string", "format": "date-time" },
            "description": "Generate tasks only on the specified dates (no workday filtering).",
            "example": ["2026-04-15T00:00:00Z", "2026-05-01T00:00:00Z"]
          },
          "every_nth_day": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Generate a task every N-th day (workdays only).",
            "example": 3
          },
          "every_nth_monthday": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 31,
            "description": "Generate a task on the N-th day of each month (workdays only).",
            "example": 15
          },
          "every_even_day": {
            "type": "boolean",
            "description": "If true, generate tasks on even-numbered days; if false, on odd-numbered days (workdays only).",
            "example": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "task not found" }
        }
      }
    }
  }
}
